{
  "name": "kindred-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kindred memory engine: Bonsai-driven layered people memory with paged recall",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "kindred": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "demo": "node --disable-warning=ExperimentalWarning src/cli.mjs demo",
    "eval": "node --disable-warning=ExperimentalWarning eval/run.mjs",
    "stress": "node --disable-warning=ExperimentalWarning eval/stress.mjs",
    "compare:embeddings": "node --disable-warning=ExperimentalWarning eval/embedding-compare-cli.mjs",
    "server": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "kindred": "node --disable-warning=ExperimentalWarning src/cli.mjs",
    "compare": "node --disable-warning=ExperimentalWarning eval/compare.mjs",
    "summarize": "node --disable-warning=ExperimentalWarning eval/summarize.mjs"
  }
}
